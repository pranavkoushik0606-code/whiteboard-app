# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (local via docker-compose, or your own MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/whiteboard

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (no signup needed — Ethereal test inbox is auto-created in code,
# these vars are only used if you later swap in a real SMTP provider)
EMAIL_FROM=noreply@whiteboard.dev

# Origin used to build the absolute URL returned by POST /uploads/image.
# Leave unset in development; set it in production, because the fallback reads
# the request's Host header and that URL is stored as an object's src.
# PUBLIC_URL=https://your-api.onrender.com

# Where uploaded images go. Unset means the local ./uploads directory, which is
# fine on your own machine and wrong on any host with an ephemeral filesystem:
# on Render's free tier the container is wiped on restart and sleeps after ~15
# minutes idle, so uploads do not survive the day. Copy the value from the
# Cloudinary dashboard ("API Environment variable"); it contains the API secret,
# so it belongs in the host's env, not in a committed file.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# The split form works too, and all three are required together -- two out of
# three reads as "not configured" rather than half-working.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=whiteboard

# Overrides how the app decides which X-Forwarded-For entry is the caller.
# Leave it unset unless you have a reason: the default trusts every private
# address and takes the first public one, which needs no hop count and is right
# behind Render/Fly/Railway/Heroku. Never set it to `true` -- that trusts the
# client-written end of the chain and lets anyone bypass the rate limiter.
# TRUST_PROXY=
